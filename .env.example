# Supabase project configuration
# Get your project URL and publishable key from your Supabase dashboard
# https://supabase.com/docs/guides/getting-started/local-development

# Required - Project URL (starts with https:// and ends with .supabase.co)
VITE_SUPABASE_URL=https://twphcebtujedxituqwwr.supabase.co

# Required - Anonymous key (client-side, safe to expose)
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only - Secret key (NEVER commit this to version control or expose in frontend)
# SUPABASE_SECRET_KEY=YOUR_SECRET_KEY